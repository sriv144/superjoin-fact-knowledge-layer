# Fact Knowledge Layer - Environment Configuration

# Primary LLM Provider: NVIDIA NIM (Nemotron)
# Obtain key from: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Bound a single hosted-model request so an unavailable provider fails safely.
NVIDIA_REQUEST_TIMEOUT_SECONDS=45

# Database configuration (defaults to data/facts.db)
DATABASE_PATH=data/facts.db
