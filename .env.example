# Fact Knowledge Layer - Environment Configuration

# Primary LLM Provider: Google Gemini
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional Alternative: OpenAI or any OpenAI-compatible provider (e.g. OpenRouter, Groq, Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Database configuration (defaults to data/facts.db)
DATABASE_PATH=data/facts.db
